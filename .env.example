# COPY THIS FILE TO .env, THEN EDIT THE MODEL CONNECTION.
# Ollama local (no paid API key):
CREATIVITY_BASE_URL=http://localhost:11434/v1
CREATIVITY_MODEL=gemma3:4b
CREATIVITY_API_KEY=

# Alternatively, use any provider exposing an OpenAI-compatible /chat/completions API.
# Examples: OpenAI, NVIDIA NIM, Groq, LM Studio, vLLM.
# Ensure the model supports instruction following and JSON output.
# CREATIVITY_BASE_URL=https://YOUR_PROVIDER_URL/v1
# CREATIVITY_MODEL=your-model-id
# CREATIVITY_API_KEY=your-secret

CREATIVITY_TIMEOUT=90
# Only needed if you expose HTTP outside localhost:
# CREATIVITY_SERVER_TOKEN=use-a-long-random-secret
